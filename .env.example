# Copy this file to .env before starting the local development stack.
PROJECT_SUFFIX=dev
LOCALHOST=localhost

PAYMENTS_SERVICE_PORT=9069
PAYMENTS_POSTGRES_PORT=9269
PAYMENTS_POSTGRES_PORT_INNER=5432
PAYMENTS_POSTGRES_HOST=payments-db
PAYMENTS_POSTGRES_DB_NAME=payments

SPRING_DATASOURCE_URL=jdbc:postgresql://payments-db:5432/payments
SPRING_DATASOURCE_USERNAME=payments_user
SPRING_DATASOURCE_PASSWORD=replace_with_a_local_password

POSTGRES_USER=payments_admin
POSTGRES_PASSWORD=replace_with_a_local_postgres_password
POSTGRES_DB=postgres
